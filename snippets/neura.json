{
  "Main function": {
    "prefix": "main",
    "body": ["fn main():", "    ${0:pass}"],
    "description": "Program entry point"
  },
  "Function": {
    "prefix": "fn",
    "body": ["fn ${1:name}(${2})${3: -> ${4:Unit}}:", "    ${0:pass}"],
    "description": "Define a function"
  },
  "Struct": {
    "prefix": "struct",
    "body": ["struct ${1:Name}:", "    ${2:field}: ${3:Int}"],
    "description": "Define a struct"
  },
  "Import": {
    "prefix": "import",
    "body": ["import neura.${1:nn} as ${2:nn}"],
    "description": "Import a Neura module"
  },
  "Streaming inference directive": {
    "prefix": "addls",
    "body": ["add ls"],
    "description": "Enable layer-by-layer streaming inference for sequential models"
  },
  "Immutable binding": {
    "prefix": "let",
    "body": ["let ${1:name} = ${0:value}"],
    "description": "Declare an immutable binding"
  },
  "Mutable binding": {
    "prefix": "letmut",
    "body": ["let mut ${1:name} = ${0:value}"],
    "description": "Declare a mutable binding"
  },
  "If statement": {
    "prefix": "if",
    "body": ["if ${1:condition}:", "    ${0:pass}"],
    "description": "If statement"
  },
  "If / else": {
    "prefix": "ifelse",
    "body": ["if ${1:condition}:", "    ${2:pass}", "else:", "    ${0:pass}"],
    "description": "If / else statement"
  },
  "For loop": {
    "prefix": "for",
    "body": ["for ${1:i} in ${2:range(${3:0}, ${4:10})}:", "    ${0:pass}"],
    "description": "For loop"
  },
  "While loop": {
    "prefix": "while",
    "body": ["while ${1:condition}:", "    ${0:pass}"],
    "description": "While loop"
  },
  "Read input": {
    "prefix": "input",
    "body": ["${1:name} = input(${2:\"prompt: \"}, ${0:Str})"],
    "description": "Read a line from stdin"
  },
  "Sequential model": {
    "prefix": "sequential",
    "body": [
      "${1:model} = nn.Sequential([nn.Linear(${2:2}, ${3:8}), nn.ReLU(), nn.Linear(${3:8}, ${4:3})])"
    ],
    "description": "Build a sequential model"
  },
  "Tensor literal": {
    "prefix": "tensor",
    "body": ["Tensor([[${0:0.0}]])"],
    "description": "Tensor literal"
  }
}
